# Copy to .env, then set MINIMAX_API_KEY.
#
# .env wins over variables inherited from your shell. That is deliberate: a stale
# NOMADGUARD_* export from an earlier shell must not silently turn a live setup into
# an offline one. Check what was resolved with `python -m nomadguard providers`.

# --- credentials -------------------------------------------------------------
MINIMAX_API_KEY=

# --- capability bindings: provider | model ----------------------------------
# Each capability resolves independently. Swap one without touching the others.
NOMADGUARD_TEXT_PROVIDER=minimax
NOMADGUARD_TEXT_MODEL=MiniMax-M3.1-Flash
NOMADGUARD_VISION_PROVIDER=minimax
NOMADGUARD_VISION_MODEL=MiniMax-M3.1-Flash
NOMADGUARD_IMAGE_PROVIDER=minimax
NOMADGUARD_IMAGE_MODEL=image-01
NOMADGUARD_VIDEO_PROVIDER=minimax
NOMADGUARD_VIDEO_MODEL=MiniMax-H3-Lite
NOMADGUARD_VIDEO_RESOLUTION=480P
NOMADGUARD_VOICE_PROVIDER=minimax
NOMADGUARD_VOICE_MODEL=speech-2.8-turbo
NOMADGUARD_VOICE_ID=English_Persuasive_Man

# Offline providers exist for tests and demos and produce labelled placeholder
# footage. They are refused unless this is explicitly 1.
NOMADGUARD_ALLOW_PLACEHOLDER=0

# Optional second text/vision implementation (any verified-compatible endpoint).
# Set the capability's model above to the vendor's model id when you switch.
# NOMADGUARD_TEXT_PROVIDER=openai_compat
# NOMADGUARD_VISION_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=

# --- execution policy --------------------------------------------------------
# PROPOSED VALUES. These were flagged for sign-off in the design doc and are not
# silently defaulted in code: change them here when the numbers are confirmed.
NOMADGUARD_RETRY_MAX_ATTEMPTS=3
NOMADGUARD_RETRY_BACKOFF_S=5
NOMADGUARD_POLL_INTERVAL_S=10
NOMADGUARD_STALENESS_S=600
NOMADGUARD_QA_MIN_MEAN=7
NOMADGUARD_QA_MIN_DIMENSION=6
NOMADGUARD_DURATION_TOLERANCE_S=0.5
NOMADGUARD_ASPECT_TOLERANCE=0.03
NOMADGUARD_RESOLUTION_FLOOR_SHORT_EDGE=480
NOMADGUARD_VOICE_START_S=0.6

# --- local paths -------------------------------------------------------------
NOMADGUARD_JOBS_DIR=jobs
NOMADGUARD_BRIEF_PATH=briefs/nomadguard.json
NOMADGUARD_FFMPEG=ffmpeg
NOMADGUARD_FFPROBE=ffprobe
# Windows ships this font; on other systems point at any bold sans-serif TTF.
NOMADGUARD_FONT_PATH=C:/Windows/Fonts/arialbd.ttf
# Needs a check glyph. Auto-detected when empty.
# NOMADGUARD_SYMBOL_FONT=C:/Windows/Fonts/seguisym.ttf
